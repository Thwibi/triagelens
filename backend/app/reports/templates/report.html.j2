<!DOCTYPE html>
{#- Self-contained report (spec 08 section 2): inline CSS and SVG, no external
    requests, no JavaScript. Every log-derived value is escaped by Jinja2's
    autoescape. Technique and reference URLs are rendered as plain text, never
    as href/src, so opening the file offline makes zero network requests. -#}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ data.meta.title }}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { font-family: system-ui, "Segoe UI", Roboto, sans-serif; color: #1b1f23; margin: 0; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 32px 64px; }
  h1 { font-size: 24px; margin: 8px 0 4px; }
  h2 { font-size: 18px; border-bottom: 1px solid #d0d7de; padding-bottom: 4px; margin-top: 32px; }
  h3 { font-size: 15px; margin: 20px 0 6px; }
  p, li { font-size: 14px; line-height: 1.5; }
  .muted { color: #57606a; font-size: 12px; }
  .sensitive { color: #9a6700; font-size: 12px; font-weight: 600; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0; font-size: 13px; }
  th, td { border: 1px solid #d0d7de; padding: 5px 8px; text-align: left; vertical-align: top; }
  th { background: #f6f8fa; }
  tr { break-inside: avoid; }
  td, th { overflow-wrap: anywhere; }
  code, pre { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 12.5px; }
  pre { background: #f6f8fa; border: 1px solid #d0d7de; padding: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px; }
  .chip { border: 1px solid #d0d7de; border-radius: 6px; padding: 6px 8px; font-size: 13px; }
  .badge { display: inline-block; border-radius: 10px; padding: 1px 8px; font-size: 11px; font-weight: 600; color: #1b1f23; }
  .cover { margin-bottom: 8px; }
  .meta-grid { display: grid; grid-template-columns: 180px 1fr; font-size: 13px; row-gap: 3px; }
  .meta-grid dt { color: #57606a; }
  .meta-grid dd { margin: 0; }
  section { page-break-before: auto; }
  svg { max-width: 100%; height: auto; }
  @media print {
    main { max-width: none; padding: 8px; }
    h2 { page-break-after: avoid; }
    section { page-break-inside: auto; }
  }
</style>
</head>
<body>
<main>
  <header class="cover">
    <div class="sensitive">Contains evidence-derived data</div>
    <h1>{{ data.meta.title }}</h1>
    <p class="muted">Generated by {{ data.meta.tool_version }} on {{ data.meta.generated_at }} (UTC, case timezone {{ data.meta.timezone }}).</p>
    <dl class="meta-grid">
      <dt>Case</dt><dd>{{ data.meta.case_name }} ({{ data.meta.case_id }})</dd>
      <dt>Analyst</dt><dd>{{ data.meta.analyst }}</dd>
      <dt>ATT&amp;CK version</dt><dd>{{ data.meta.attack_version }}</dd>
      <dt>Ruleset hash</dt><dd><code>{{ data.meta.ruleset_hash }}</code></dd>
      {% if data.meta.detection_profile %}
      <dt>Detection profile</dt><dd>{{ data.meta.detection_profile }}</dd>
      {% endif %}
      <dt>Report id</dt><dd>{{ data.meta.report_id }}</dd>
    </dl>
  </header>

  {% if data.include.summary %}
  <section id="summary">
    <h2>Executive summary</h2>
    <p>{{ data.summary.paragraph }}</p>
    <table>
      <tr><th>Metric</th><th>Value</th></tr>
      <tr><td>Time span</td><td>{{ data.summary.first_seen or "–" }} to {{ data.summary.last_seen or "–" }}</td></tr>
      <tr><td>Sources</td><td>{{ data.summary.source_count }}</td></tr>
      <tr><td>Events</td><td>{{ data.summary.event_count }}</td></tr>
      <tr><td>Parse errors</td><td>{{ data.summary.error_count }}</td></tr>
      <tr><td>Alerts</td><td>{{ data.summary.alert_total }}</td></tr>
      <tr><td>By level</td><td>
        {%- for level in ["critical", "high", "medium", "low", "informational"] -%}
          {%- if data.summary.alerts_by_level.get(level) -%}
            <span class="badge" style="background: {{ level_color.get(level, '#e8e8e8') }}">{{ data.summary.alerts_by_level[level] }} {{ level }}</span>
          {%- endif -%}
        {%- endfor -%}
      </td></tr>
      <tr><td>Top techniques</td><td>{{ data.summary.top_techniques | map(attribute='name') | join(", ") or "none" }}</td></tr>
      <tr><td>Top indicators</td><td>{{ data.summary.top_iocs | map(attribute='value') | join(", ") or "none" }}</td></tr>
      <tr><td>Affected hosts</td><td>{{ data.summary.hosts | join(", ") or "none" }}</td></tr>
      <tr><td>Affected users</td><td>{{ data.summary.users | join(", ") or "none" }}</td></tr>
    </table>
  </section>
  {% endif %}

  {% if data.include.alerts and data.alerts %}
  <section id="alerts">
    <h2>Alert overview</h2>
    <table>
      <tr><th>Level</th><th>Score</th><th>Title</th><th>Technique(s)</th><th>Host</th><th>User</th><th>Count</th><th>Status</th></tr>
      {% for alert in data.alerts %}
      <tr>
        <td><span class="badge" style="background: {{ level_color.get(alert.level, '#e8e8e8') }}">{{ alert.level }}</span></td>
        <td>{{ alert.score }}</td>
        <td>{{ alert.rule_title | cell }}</td>
        <td>{{ alert.techniques | map(attribute='id') | join("; ") }}</td>
        <td>{{ alert.host or "–" }}</td>
        <td>{{ alert.user_name or "–" }}</td>
        <td>{{ alert.match_count }}</td>
        <td>{{ alert.status }}</td>
      </tr>
      {% endfor %}
    </table>

    {% for alert in data.alerts %}
    <h3>{{ alert.rule_title | cell }} — <span class="muted">{{ alert.id }}</span></h3>
    <div class="grid">
      <div class="chip"><strong>Level</strong><br>{{ alert.level }}</div>
      <div class="chip"><strong>Score</strong><br>{{ alert.score }}</div>
      <div class="chip"><strong>Status</strong><br>{{ alert.status }}</div>
      <div class="chip"><strong>Matches</strong><br>{{ alert.match_count }}</div>
    </div>
    {% if alert.description %}<p>{{ alert.description | cell }}</p>{% endif %}
    <table>
      <tr><th>Detail</th><th>Value</th></tr>
      {% for tactic in alert.tactics %}
      <tr><td>Tactic</td><td>{{ tactic.name }} ({{ tactic.shortname }})</td></tr>
      {% endfor %}
      {% for technique in alert.techniques %}
      <tr><td>Technique</td><td>{{ technique.name }} ({{ technique.id }}) — {{ technique.url }}</td></tr>
      {% endfor %}
      <tr><td>First seen</td><td>{{ alert.first_seen_ms }}</td></tr>
      <tr><td>Last seen</td><td>{{ alert.last_seen_ms }}</td></tr>
      <tr><td>Host</td><td>{{ alert.host or "–" }}</td></tr>
      <tr><td>User</td><td>{{ alert.user_name or "–" }}</td></tr>
      {% for item in alert.score_breakdown %}
      <tr><td>Score: {{ item.label }}</td><td>{{ item.delta }}</td></tr>
      {% endfor %}
      {% if alert.analyst_notes %}<tr><td>Analyst notes</td><td>{{ alert.analyst_notes | cell }}</td></tr>{% endif %}
      {% if alert.false_positives %}
      <tr><td>False positives</td><td>{{ alert.false_positives | join("; ") | cell }}</td></tr>
      {% endif %}
      {% if alert.references %}
      <tr><td>References</td><td>{{ alert.references | join("; ") | cell }}</td></tr>
      {% endif %}
      {% if alert.iocs %}
      <tr><td>Linked IOCs</td><td>{{ alert.iocs | map(attribute='value') | join("; ") | cell }}</td></tr>
      {% endif %}
    </table>
    {% if alert.events %}
    <p class="muted">Evidence events ({{ alert.events | length }}):</p>
    <table>
      <tr><th>Time</th><th>Host</th><th>Channel</th><th>Event id</th><th>User</th><th>Message</th></tr>
      {% for event in alert.events %}
      <tr>
        <td>{{ event.ts_iso or event.ts_ms }}</td>
        <td>{{ event.host or "–" }}</td>
        <td>{{ event.channel or "–" }}</td>
        <td>{{ event.event_id or "–" }}</td>
        <td>{{ event.user_name or "–" }}</td>
        <td>{{ event.message | cell }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
    {% endfor %}
  </section>
  {% endif %}

  {% if data.include.mitre and data.mitre.matrix and data.mitre.matrix.tactics %}
  <section id="mitre">
    <h2>ATT&amp;CK coverage</h2>
    <p class="muted">Attack version {{ data.mitre.matrix.attack_version }}
      ({{ data.mitre.matrix.unmapped_alert_count }} alert(s) without a technique mapping).</p>
    {% if heatgrid.columns %}
    <svg viewBox="0 0 {{ heatgrid.width }} {{ heatgrid.height }}" role="img" aria-label="MITRE ATT&amp;CK coverage heat grid">
      {% for column in heatgrid.columns %}
      {% set outer_index = loop.index0 %}
      <text x="{{ (outer_index + 1) * heatgrid.col_w * 0.5 + 15 }}" y="12" font-size="10">{{ column.name }}</text>
      {% for cell in column.cells %}
      {% set x = outer_index * heatgrid.col_w + 15 %}
      {% set y = heatgrid.label + loop.index0 * heatgrid.row_h %}
      <g>
        <rect x="{{ x }}" y="{{ y }}" width="{{ heatgrid.col_w - 6 }}"
              height="{{ heatgrid.row_h - 4 }}" rx="2"
              fill="{{ level_color.get(cell.level, '#f6f8fa') }}"/>
        <title>{{ cell.name }}</title>
      </g>
      {% endfor %}
      {% endfor %}
    </svg>
    {% endif %}
    {% for tactic in data.mitre.matrix.tactics %}
    {% if tactic.techniques %}
    <h3>{{ tactic.name }}</h3>
    <ul>
      {% for technique in tactic.techniques %}
      <li>{{ technique.name }} ({{ technique.id }}) — {{ technique.alert_count }} alert(s)</li>
      {% if technique.subtechniques %}
      <ul>
        {% for sub in technique.subtechniques %}
        <li>{{ sub.name }} ({{ sub.id }}) — {{ sub.alert_count }} alert(s)</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endfor %}
    </ul>
    {% endif %}
    {% endfor %}
    {% if data.mitre.navigator_layer %}
    <p class="muted">Navigator layer: {{ data.mitre.navigator_layer.name }}
      ({{ data.mitre.navigator_layer.techniques | length }} entries).</p>
    {% endif %}
  </section>
  {% endif %}

  {% if data.include.iocs and data.iocs %}
  <section id="iocs">
    <h2>Indicators of compromise</h2>
    <p class="muted">External, non-allowlisted indicators. Values are shown defanged where possible.</p>
    <table>
      <tr><th>Type</th><th>Value</th><th>Confidence</th><th>Occurrences</th>
          <th>First seen</th><th>Last seen</th><th>Analyst state</th></tr>
      {% for ioc in data.iocs %}
      <tr>
        <td>{{ ioc.type }}</td>
        <td>{{ ioc.defanged | cell }}</td>
        <td>{{ ioc.confidence }}</td>
        <td>{{ ioc.occurrences }}</td>
        <td>{{ ioc.first_seen or "–" }}</td>
        <td>{{ ioc.last_seen or "–" }}</td>
        <td>{{ ioc.analyst_state }}</td>
      </tr>
      {% endfor %}
    </table>
  </section>
  {% endif %}

  {% if data.include.timeline and data.timeline.buckets %}
  <section id="timeline">
    <h2>Timeline</h2>
    <p class="muted">{{ data.timeline.buckets | sum(attribute='count') }} events;
      alert markers are shown in red.</p>
    {% if timeline.bars %}
    <svg viewBox="0 0 {{ timeline.width }} {{ timeline.height }}" role="img" aria-label="Event volume timeline">
      <line x1="15" y1="{{ timeline.height - 20 }}" x2="{{ timeline.width }}" y2="{{ timeline.height - 20 }}" stroke="#d0d7de"/>
      {% for bar in timeline.bars %}
      <rect x="{{ bar.x }}" y="{{ bar.y }}" width="4" height="{{ bar.h }}" fill="#1b6ac9"/>
      {% if bar.alerts > 0 %}
      <circle cx="{{ bar.x + 2 }}" cy="10" r="2.5" fill="#ff6666"/>
      {% endif %}
      {% endfor %}
    </svg>
    {% endif %}
  </section>
  {% endif %}

  {% if data.include.entities and data.entities %}
  <section id="entities">
    <h2>Entities</h2>
    <table>
      <tr><th>Kind</th><th>Name</th><th>Events</th><th>Alerts</th></tr>
      {% for entity in data.entities %}
      <tr>
        <td>{{ entity.kind }}</td>
        <td>{{ entity.name | cell }}</td>
        <td>{{ entity.event_count }}</td>
        <td>{{ entity.alert_count }}</td>
      </tr>
      {% endfor %}
    </table>
  </section>
  {% endif %}

  <section id="integrity">
    <h2>Evidence integrity and methodology</h2>
    <h3>Sources</h3>
    <table>
      <tr><th>Filename</th><th>Log type</th><th>Status</th><th>Size</th>
          <th>SHA-256</th><th>Events</th><th>Errors</th></tr>
      {% for source in data.sources %}
      <tr>
        <td>{{ source.filename | cell }}</td>
        <td>{{ source.log_type or "–" }}</td>
        <td>{{ source.status }}</td>
        <td>{{ source.size_bytes }}</td>
        <td><code>{{ source.sha256 }}</code></td>
        <td>{{ source.event_count }}</td>
        <td>{{ source.error_count }}</td>
      </tr>
      {% endfor %}
    </table>
    <h3>Detection runs</h3>
    {% for run in data.runs %}
    <p class="muted">{{ run.id }} — {{ run.profile }} — {{ run.status }}:
      {{ run.rules_ok }} ok, {{ run.rules_skipped }} skipped,
      {{ run.rules_timeout }} timeout, {{ run.rules_error }} error.</p>
    {% endfor %}
    <h3>Audit</h3>
    <p class="muted">Hash-chain verification: {{ data.audit_verification.chain_ok }}
      ({{ data.audit_verification.rows_checked }} row(s) checked).</p>
    <p>All logs were processed locally on the analysing workstation; no data left the machine.</p>
  </section>

  {% if data.include.appendix and data.appendix_raw %}
  <section id="appendix">
    <h2>Appendix — raw events</h2>
    {% for entry in data.appendix_raw %}
    <h3>Alert {{ entry.alert_id }}</h3>
    {% for event in entry.events %}
    <pre>{{ event.raw or "(no raw)" }}</pre>
    {% endfor %}
    {% endfor %}
  </section>
  {% endif %}
</main>
</body>
</html>