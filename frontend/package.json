{
  "name": "triagelens-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TriageLens web UI - offline only, all assets bundled",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build --force && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/openapi.d.ts",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.14",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
